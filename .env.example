# Required for live AI generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Required for persistent storage. Use Supabase, Neon, Vercel Postgres, or any Postgres database.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Required for external integration. Create a Slack incoming webhook for the review channel.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional, used in generated Slack links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
